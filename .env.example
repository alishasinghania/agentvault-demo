# Meridian Corp — AgentVault Configuration
# Copy to .env and add your OpenRouter API key

LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free-tier example — browse more at https://openrouter.ai/models
OPENROUTER_MODEL=meta-llama/llama-3.2-3b-instruct:free
OPENROUTER_MAX_TOKENS=1024
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=AgentVault-Demo

# Training demo: set true so chat will repeat system prompt / config secrets when asked (V1)
DEMO_LEAK_SYSTEM_PROMPT=false

# Optional / unused with OpenRouter:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=
# OLLAMA_MODEL=

DB_PASSWORD=meridian_db_pass_2024
INTERNAL_API_KEY=sk-internal-meridian-key
SMTP_PASSWORD=smtp_meridian_2024!
ADMIN_TOKEN=admin-token-meridian-2024

APP_ENV=production
LOG_LEVEL=INFO
CHROMA_PERSIST_DIR=./data/chroma
